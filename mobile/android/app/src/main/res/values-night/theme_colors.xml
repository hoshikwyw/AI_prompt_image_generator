<?xml version="1.0" encoding="utf-8"?>
<!-- Dark mode. Android picks this folder when the phone is in dark mode. -->
<resources>
    <!-- The site's dark page background (the "background" token in web/app/globals.css). -->
    <color name="app_background">#0A0C12</color>
    <!-- Light status-bar icons, readable on the dark background. -->
    <bool name="light_system_bars">false</bool>
</resources>
