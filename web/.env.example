# --- Supabase (the backend) -------------------------------------------------
# Dashboard -> Project Settings -> API. Apply supabase/migrations first; see
# supabase/README.md.
#
# Read by the server at startup, never sent to a browser — nothing client-side
# talks to Supabase. Without these the app falls back to the local JSON
# collection in .data/, which is fine for one machine but shares nothing.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# service_role bypasses RLS. Server-only, never sent to a browser, and the
# reason writes must stay behind the admin gate. Leave blank for a read-only
# deployment.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for sample images. Created by the migration.
SUPABASE_BUCKET=prompt-samples

# --- Admin gate -------------------------------------------------------------
# Reading is always public. Set this to require a passphrase before anything
# can be created, edited, deleted or imported.
#
# Unset behaves differently depending on where the data lives: with the local
# JSON collection, editing stays open (it is your own machine); with Supabase,
# editing is refused outright, because shared data must never be editable by
# whoever finds the URL.
ADMIN_PASSPHRASE=

# --- Link previews ----------------------------------------------------------
# The public address, for the absolute URLs in link previews (Open Graph).
# Optional on Vercel, which supplies the production domain itself.
SITE_URL=

# --- Public API fair use (optional) -------------------------------------------
# A free Upstash Redis database (upstash.com, no card needed) turns on the
# per-address rate limit for /api/v1 and the usage counts on /admin. Left blank,
# the API simply runs unlimited. Copy both from the database's REST API panel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Requests per minute per address. Defaults to 60.
API_RATE_LIMIT_PER_MINUTE=
