# Nothing here is required to run the app. The prompt collection is a local
# JSON file under .data/ and needs no credentials.
#
# These are the image-generation providers from Phase 0/1. Their code is still
# in lib/providers/, but nothing in the UI reaches it — fill these in when
# generation comes back.

# --- Cloudflare Workers AI (free: 10,000 neurons/day, ~91 images at 1024px) ---
# Account ID: dash.cloudflare.com -> Workers & Pages -> Account details
# API Token:  dash.cloudflare.com/profile/api-tokens -> Create Token -> "Workers AI" template
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- Gemini (paid only; image models need billing enabled) ---
# aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
