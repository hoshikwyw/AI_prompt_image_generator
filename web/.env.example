# --- Supabase (the backend) -------------------------------------------------
# Dashboard -> Project Settings -> API. Apply supabase/migrations first; see
# supabase/README.md.
#
# Read by the server at startup, never sent to a browser — nothing client-side
# talks to Supabase. Without these the app falls back to the local JSON
# collection in .data/, which is fine for one machine but shares nothing.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# service_role bypasses RLS. Server-only, never sent to a browser, and the
# reason writes must stay behind the admin gate. Leave blank for a read-only
# deployment.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for sample images. Created by the migration.
SUPABASE_BUCKET=prompt-samples

# --- Image generation (dormant) ---------------------------------------------
# Nothing below is needed to run the app. The provider code in lib/providers/
# is still here, but no UI path reaches it — fill these in when generation
# comes back.

# Cloudflare Workers AI (free: 10,000 neurons/day, ~91 images at 1024px)
# Account ID: dash.cloudflare.com -> Workers & Pages -> Account details
# API Token:  dash.cloudflare.com/profile/api-tokens -> "Workers AI" template
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Gemini (paid only; image models need billing enabled) — aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
